""" Console for spaceship game. """

import tkinter as tk

class Console(tk.Tk):

    def __init__(self, sound_muted: bool):
        super().__init__()
        self.title("Console")
        self.sound_muted = sound_muted

        # Set a fixed window size
        self.geometry("590x500")  # Example size
        self.resizable(False, False)  # Prevent resizing

        # Output window (Text)
        self.text_widget = tk.Text(self, height=25, width=110, bg="gray", fg="white")
        self.text_widget.pack()

        # Input field (Entry)
        self.entry = tk.Entry(self, width=80, bg="gray", fg="white")
        self.entry.pack()
        self.entry.bind("<Return>", self.execute_command)  # Execute command on Enter

    def execute_command(self, event):
        command = self.entry.get()
        self.text_widget.insert(tk.END, f"> {command}\n")  # Add command to output window
        self.entry.delete(0, tk.END)  # Clear input field

        try:
            result = ("SpaceShip Battle! Build 1.0"
                      "\nAuthor: I#Oleg"
                      "\nVersion: 1.0"
                      "\nDate compiled: 15.02.2025")
            if command == "m_soundmute 1":
                self.sound_muted = True
                result = "Sound muted."
            elif command == "m_soundmute 0":
                self.sound_muted = False
                result = "Sound unmuted."
            elif command == "cls":
                self.text_widget.delete("1.0", tk.END)
            else:
                result = f"Unknown command: {command}"
        except Exception as e:
            result = str(e)

        self.text_widget.insert(tk.END, result + "\n")  # Output result
        self.text_widget.see(tk.END)  # Scroll to the bottom (like Half-Life 2 console)
